# Imagen común para los 4 servicios NestJS. Uso: build args APP=<carpeta en apps/>
FROM node:22-alpine
RUN npm i -g pnpm@9
WORKDIR /repo
ARG APP
COPY . .
RUN pnpm install --no-frozen-lockfile --filter "@poc/${APP}..." \
 && pnpm --filter "@poc/${APP}..." build
ENV APP_DIR=apps/${APP}
CMD ["sh", "-c", "node $APP_DIR/dist/main.js"]
