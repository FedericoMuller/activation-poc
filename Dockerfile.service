# Imagen común para los servicios NestJS. Uso: build arg APP=<carpeta en apps/>
FROM node:22-alpine
RUN npm i -g pnpm@9
WORKDIR /repo
ARG APP
COPY . .
RUN pnpm install --no-frozen-lockfile --filter "@poc/${APP}..." \
 && pnpm --filter "@poc/${APP}..." build
WORKDIR /repo/apps/${APP}
# Forma exec: node es PID 1 y recibe SIGTERM (enableShutdownHooks) para salir del consumer group.
CMD ["node", "dist/main.js"]
